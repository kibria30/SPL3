# Copy to `.env` (never commit it) and fill in the secrets.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=tsf
POSTGRES_DB=tsf_forecasting_app
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Backend ----------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# --- Public entry point (Caddy) ---------------------------------------------
# Host port that serves the site: http://<vps-ip>:8742  (pick anything that is free on the VPS)
HTTP_PORT=8742
# Leave as :80 (container-internal listen address) while running plain HTTP on an IP.
SITE_ADDRESS=:80
