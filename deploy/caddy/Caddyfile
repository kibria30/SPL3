{
	# Plain HTTP for now (IP-only deployment). To serve HTTPS with a domain, see DEPLOY.md.
	auto_https off
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# /api/* -> FastAPI, with the /api prefix stripped (the backend routes have no prefix).
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Everything else -> Next.js
	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
